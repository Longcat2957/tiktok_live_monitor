# 이 파일을 .env로 복사한 뒤 필요한 값을 수정하세요. #으로 시작하는 줄은 설명입니다.
# 방송 계정은 웹 화면에서 입력합니다. TIKTOK_USERNAME은 사용하지 않습니다.
# 선택 계정과 댓글은 메모리에만 유지되며, 백엔드 재시작 후 계정을 다시 입력해야 합니다.
# 아래 큐/보관 수/간격/로그 수준은 현재 모드에 맞는 모니터 설정에서도 변경할 수 있습니다.
# 모달 변경은 메모리에만 반영됩니다. 서버 재시작 시 이 파일의 값으로 돌아갑니다.
# Docker에서 변경 적용: docker compose up -d --wait (restart만으로는 반영되지 않음)

# 첫 화면에서 미리 선택할 모드: tiktok = 실제 방송 / mock = 가짜 댓글 데모
# 초기 선택값일 뿐 자동 실행하지 않습니다. 화면에서 모드를 선택하고 시작을 누르세요.
# 모드·계정 변경은 모니터 종료 후 첫 화면에서 합니다. .env 수정은 필요하지 않습니다.
COMMENT_SOURCE=tiktok

# 전달 전 댓글 대기 공간의 최대 개수 (1~10000).
# 가득 차면 가장 오래된 댓글을 버리고 최신 댓글을 받습니다. 기본값 유지 권장.
COMMENT_QUEUE_SIZE=500

# 브라우저가 유지하는 최근 댓글 개수 (1~1000). 파일에 저장하지 않습니다.
# 동시에 보이는 개수는 모니터 크기와 댓글 길이에 따라 달라집니다.
COMMENT_HISTORY_SIZE=30

# TikTok 재연결 대기 시간(초). 실패가 반복되면 2 → 4 → 8 → 16 → 30초로 증가합니다.
# 최소 간격: 0 초과~300 / 최대 간격: 0 초과~3600, 최소 간격 이상이어야 합니다.
TIKTOK_RECONNECT_MIN_SECONDS=2
TIKTOK_RECONNECT_MAX_SECONDS=30

# 앱 로그 상세 수준 (외부 라이브러리의 DEBUG는 켜지지 않습니다): DEBUG / INFO / WARNING / ERROR / CRITICAL. 일반 운영은 INFO.
LOG_LEVEL=INFO

# 서버 수신 주소와 포트. Docker Compose에서는 아래 값으로 고정되어
# .env에서 바꿔도 적용되지 않습니다. Pi 브라우저 접속 주소: http://127.0.0.1:8000
# 0.0.0.0은 컨테이너 내부 수신 주소이며, 호스트 공개 범위는 localhost로 제한됩니다.
HOST=0.0.0.0
PORT=8000

# mock 댓글 생성 간격(초, 0 초과~3600). 기본 1.5초이며 tiktok 모드에서는 무시됩니다.
# 변경하려면 아래 줄 맨 앞의 #을 지우고 숫자를 수정하세요.
# MOCK_INTERVAL_SECONDS=1.5
